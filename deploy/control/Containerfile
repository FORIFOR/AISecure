# Build and review the image, then pass the immutable image@sha256 digest.
# No runtime credentials, host mounts, elevated capabilities or network.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml setup.cfg README.md LICENSE ./
COPY aisecure ./aisecure
RUN pip install --no-cache-dir '.[control]'
USER 65532:65532
CMD ["python", "-m", "aisecure.control.worker", "pdf"]
